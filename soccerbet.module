<?php

/**
 * @file
 * Soccer Bet – Fußball-Tippspiel Modul für Drupal 11.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\soccerbet\Hook\SoccerbetHooks;
use Drupal\Core\Url;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function soccerbet_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::service(SoccerbetHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function soccerbet_theme(): array {
  return \Drupal::service(SoccerbetHooks::class)->theme();
}

/**
 * Implements hook_migrate_import_MIGRATION_ID_finish().
 *
 * Nach der Tournament-Migration: aktives Turnier in soccerbet.settings setzen.
 */
#[LegacyHook]
function soccerbet_migrate_import_soccerbet_tournaments_finish(string $migration_id, array $context): void
{
    \Drupal::service(SoccerbetHooks::class)->migrateImportSoccerbetTournamentsFinish($migration_id, $context);
}
/**
 * Implements hook_preprocess_HOOK() for soccerbet_live_scoreboard.
 */
#[LegacyHook]
function soccerbet_preprocess_soccerbet_live_scoreboard(array &$variables): void {
  \Drupal::service(SoccerbetHooks::class)->preprocessSoccerbetLiveScoreboard($variables);
}

/**
 * Implements hook_preprocess_HOOK() for soccerbet_standings.
 */
#[LegacyHook]
function soccerbet_preprocess_soccerbet_standings(array &$variables): void {
  \Drupal::service(SoccerbetHooks::class)->preprocessSoccerbetStandings($variables);
}

/**
 * Implements hook_preprocess_HOOK() for soccerbet_tables.
 */
#[LegacyHook]
function soccerbet_preprocess_soccerbet_tables(array &$variables): void {
  \Drupal::service(SoccerbetHooks::class)->preprocessSoccerbetTables($variables);
}

/**
 * Implements hook_preprocess_HOOK() for soccerbet_tipper_detail.
 */
#[LegacyHook]
function soccerbet_preprocess_soccerbet_tipper_detail(array &$variables): void {
  \Drupal::service(SoccerbetHooks::class)->preprocessSoccerbetTipperDetail($variables);
}

function soccerbet_page_attachments(array &$attachments): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if (!str_starts_with($route, 'soccerbet.')) {
    return;
  }
  $attachments['#attached']['library'][] = 'soccerbet/global';

  if (str_starts_with($route, 'soccerbet.admin')) {
    $attachments['#attached']['library'][] = 'soccerbet/admin';
  }

  // Live-JSON-URL für den Menüpunkt-Dot per drupalSettings übergeben.
  $tournament_id = (int) \Drupal::config('soccerbet.settings')->get('default_tournament');
  if ($tournament_id > 0) {
    $attachments['#attached']['drupalSettings']['soccerbet']['liveJsonUrl'] =
      Url::fromRoute('soccerbet.live.json', ['tournament_id' => $tournament_id])
        ->toString();
  }
}
